# Site mode template for RW on mud.revivalworld.org (same host as driver).
# Usage:
#   cp .env.site.example .env
#   # edit MUDGATE_AUTH_TOKEN + MUDGATE_ORIGIN_ALLOWLIST
#   source ~/bin/use-node20.csh   # FreeBSD cookys private Node 20
#   npm ci && npm run build -w @mudgate/protocol && npm run build -w @mudgate/proxy
#   npm run start -w @mudgate/proxy

MUDGATE_PROXY_MODE=remote-prod
MUDGATE_SITE_MODE=1
MUDGATE_AUTH_TOKEN=CHANGE_ME_openssl_rand_hex_24
# Origins that may open the SPA (comma-separated, no spaces or with spaces trimmed)
MUDGATE_ORIGIN_ALLOWLIST=https://play.revivalworld.org,http://127.0.0.1:5173
# RW driver ports on this box (telnet banner = 重生的世界 on all four).
MUDGATE_ALLOWLIST=127.0.0.1:4000,127.0.0.1:4001,127.0.0.1:5000,127.0.0.1:6000,mud.revivalworld.org:4000,mud.revivalworld.org:4001,mud.revivalworld.org:5000,mud.revivalworld.org:6000
MUDGATE_BIND_HOST=127.0.0.1
PORT=7788
MUDGATE_TRUSTED_HOP=127.0.0.1/32
# MUDGATE_AUDIT_LOG=/home/user/admin/cookys/var/log/mudgate-proxy-audit.jsonl

# After TLS/nginx for play.* :
# VITE_PROXY_WS=wss://play.revivalworld.org/ws
# Until then, local-only smoke:
VITE_PROXY_WS=ws://127.0.0.1:7788/ws
