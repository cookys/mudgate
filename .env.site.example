# Site mode template for RW on mud.revivalworld.org (same host as driver).
# Usage:
#   cp .env.site.example .env
#   # edit ASSMUD_AUTH_TOKEN + ASSMUD_ORIGIN_ALLOWLIST
#   source ~/bin/use-node20.csh   # FreeBSD cookys private Node 20
#   npm ci && npm run build -w @assmud/protocol && npm run build -w @assmud/proxy
#   npm run start -w @assmud/proxy

ASSMUD_PROXY_MODE=remote-prod
ASSMUD_SITE_MODE=1
ASSMUD_AUTH_TOKEN=CHANGE_ME_openssl_rand_hex_24
# Origins that may open the SPA (comma-separated, no spaces or with spaces trimmed)
ASSMUD_ORIGIN_ALLOWLIST=https://play.revivalworld.org,http://127.0.0.1:5173
# RW external ports on this box
ASSMUD_ALLOWLIST=127.0.0.1:4000,127.0.0.1:4001,127.0.0.1:5000,127.0.0.1:6000
ASSMUD_BIND_HOST=127.0.0.1
PORT=7788
ASSMUD_TRUSTED_HOP=127.0.0.1/32
# ASSMUD_AUDIT_LOG=/home/user/admin/cookys/var/log/assmud-proxy-audit.jsonl

# After TLS/nginx for play.* :
# VITE_PROXY_WS=wss://play.revivalworld.org/ws
# Until then, local-only smoke:
VITE_PROXY_WS=ws://127.0.0.1:7788/ws
