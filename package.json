{
  "name": "mudgate",
  "private": true,
  "version": "0.1.0",
  "description": "Web zMUD-class multi-MUD client (RW depth benchmark)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @mudgate/protocol -w @mudgate/codec-big5 -w @mudgate/vt -w @mudgate/terminal -w @mudgate/proxy -w @mudgate/web",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "dev:proxy": "npm run dev -w @mudgate/proxy",
    "dev:web": "npm run dev -w @mudgate/web",
    "qc": "npm test && npm run test:e2e",
    "secret-scan": "bash scripts/secret-scan.sh",
    "lint": "echo 'lint: no-op until eslint lands'"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.10"
  },
  "license": "MIT"
}
