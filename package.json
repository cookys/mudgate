{
  "name": "assmud",
  "private": true,
  "version": "0.1.0",
  "description": "Web zMUD-class multi-MUD client (RW depth benchmark)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @assmud/protocol -w @assmud/codec-big5 -w @assmud/vt -w @assmud/terminal -w @assmud/proxy -w @assmud/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "dev:proxy": "npm run dev -w @assmud/proxy",
    "dev:web": "npm run dev -w @assmud/web",
    "qc": "npm test",
    "lint": "echo 'lint: no-op until eslint lands'"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.10"
  }
}
