+      for (let i = 0; i < line.length; i++) {
+        const c = line[i]!;
+        if (c >= 0x80 && i + 1 < line.length) {
+          w += 2;
+          i += 1;
+        } else {
+          w += 1;
+        }
+      }
+      return w;
+    }
+
