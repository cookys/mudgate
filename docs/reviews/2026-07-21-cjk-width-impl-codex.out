+            j += 2;
+            while (j < slice.length && !(slice[j]! >= 0x40 && slice[j]! <= 0x7e))
+              j += 1;
+            continue;
+          }
+          out.push(slice[j]!);
+        }
+        lineBytesList.push(Uint8Array.from(out));
+        start = i + 1;
+      }
+    }
+
