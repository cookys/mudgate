     1	/** Font trial helpers (F2). */
     2	
     3	/** Sample for dual-width visual trial (no MUD reconnect). */
     4	export const TRIAL_FIXTURE = `M中M中M中
     5	──│┌┐
     6	Hello 你好 重 生`;
     7	
     8	/** Ideal dual-width: fullwidth ~2× halfwidth. */
     9	export function isAlignScoreGood(score: number, tol = 0.3): boolean {
    10	  if (!Number.isFinite(score) || score <= 0) return false;
    11	  return Math.abs(score - 2) <= tol;
    12	}
    13	
    14	/** Detect missing CJK glyph via canvas (not document.fonts.check alone). */
    15	export function probeCjkGlyph(
    16	  fontFamily: string,
    17	  ch = "中",
    18	  sizePx = 16,
    19	): { ok: boolean; width: number } {
    20	  if (typeof document === "undefined") return { ok: false, width: 0 };
    21	  const canvas = document.createElement("canvas");
    22	  const ctx = canvas.getContext("2d");
    23	  if (!ctx) return { ok: false, width: 0 };
    24	  ctx.font = `500 ${sizePx}px ${fontFamily}`;
    25	  const w = ctx.measureText(ch).width;
    26	  // tofu / missing often near 0 or matches .notdef narrow
    27	  ctx.font = `500 ${sizePx}px monospace`;
    28	  const wMono = ctx.measureText(ch).width;
    29	  const ok = w > 0 && Math.abs(w - wMono) > 0.5;
    30	  return { ok, width: w };
    31	}
