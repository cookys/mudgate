FILE apps/proxy/src/limits.ts
     1	/** In-memory abuse limits (hosted-ready). Fail-closed on exceed; no payload logs. */
     2	
     3	export type LimitConfig = {
     4	  concurrentWsPerIp: number;
     5	  concurrentWsPerToken: number;
     6	  upgradesPerIpPerMin: number;
     7	  hellosPerConnPerMin: number;
     8	  helloTimeoutMs: number;
     9	};
    10	
    11	export function defaultLimits(
    12	  mode: "remote-prod" | "localhost-dev",
    13	): LimitConfig {
    14	  if (mode === "localhost-dev") {
    15	    return {
    16	      concurrentWsPerIp: envInt("ASSMUD_LIMIT_WS_IP", 64),
    17	      concurrentWsPerToken: envInt("ASSMUD_LIMIT_WS_TOKEN", 32),
    18	      upgradesPerIpPerMin: envInt("ASSMUD_LIMIT_UPGRADE_IP", 120),
    19	      hellosPerConnPerMin: envInt("ASSMUD_LIMIT_HELLO", 60),
    20	      helloTimeoutMs: envInt("ASSMUD_HELLO_TIMEOUT_MS", 30_000),
    21	    };
    22	  }
    23	  return {
    24	    concurrentWsPerIp: envInt("ASSMUD_LIMIT_WS_IP", 8),
    25	    concurrentWsPerToken: envInt("ASSMUD_LIMIT_WS_TOKEN", 4),
    26	    upgradesPerIpPerMin: envInt("ASSMUD_LIMIT_UPGRADE_IP", 30),
    27	    hellosPerConnPerMin: envInt("ASSMUD_LIMIT_HELLO", 20),
    28	    helloTimeoutMs: envInt("ASSMUD_HELLO_TIMEOUT_MS", 10_000),
    29	  };
    30	}
    31	
    32	function envInt(name: string, fallback: number): number {
    33	  const v = process.env[name];
    34	  if (v == null || v === "") return fallback;
    35	  const n = Number(v);
    36	  return Number.isFinite(n) && n > 0 ? Math.floor(n) : fallback;
    37	}
    38	
    39	/** Normalize remote address for limit keys. */
    40	export function normalizeIp(raw: string | undefined): string {
    41	  if (!raw) return "unknown";
    42	  let ip = raw;
    43	  if (ip.startsWith("::ffff:")) ip = ip.slice(7);
    44	  // strip port if host:port (rare on socket.remoteAddress)
    45	  if (ip.includes(":") && !ip.includes(".")) {
    46	    // IPv6 leave as-is
    47	    return ip.toLowerCase();
    48	  }
    49	  return ip;
    50	}
    51	
    52	type Window = { count: number; resetAt: number };
    53	
    54	export class AbuseLimiter {
    55	  private wsByIp = new Map<string, number>();
    56	  private wsByToken = new Map<string, number>();
    57	  private upgrades = new Map<string, Window>();
    58	  private hellos = new Map<string, Window>();
    59	
    60	  constructor(private readonly cfg: LimitConfig) {}
    61	
    62	  private hitWindow(map: Map<string, Window>, key: string, max: number): boolean {
    63	    const now = Date.now();
    64	    let w = map.get(key);
    65	    if (!w || now >= w.resetAt) {
    66	      w = { count: 0, resetAt: now + 60_000 };
    67	      map.set(key, w);
    68	    }
    69	    w.count += 1;
    70	    return w.count <= max;
    71	  }
    72	
    73	  /** Call on HTTP upgrade. Returns false if rejected. */
    74	  tryUpgrade(ip: string): boolean {
    75	    return this.hitWindow(this.upgrades, ip, this.cfg.upgradesPerIpPerMin);
    76	  }
    77	
    78	  /** Acquire concurrent slot after auth. Returns release fn or null. */
    79	  tryAcquire(ip: string, tokenKey: string): (() => void) | null {
    80	    const nIp = this.wsByIp.get(ip) ?? 0;
    81	    const nTok = this.wsByToken.get(tokenKey) ?? 0;
    82	    if (nIp >= this.cfg.concurrentWsPerIp) return null;
    83	    if (nTok >= this.cfg.concurrentWsPerToken) return null;
    84	    this.wsByIp.set(ip, nIp + 1);
    85	    this.wsByToken.set(tokenKey, nTok + 1);
    86	    let released = false;
    87	    return () => {
    88	      if (released) return;
    89	      released = true;
    90	      const a = (this.wsByIp.get(ip) ?? 1) - 1;
    91	      const b = (this.wsByToken.get(tokenKey) ?? 1) - 1;
    92	      if (a <= 0) this.wsByIp.delete(ip);
    93	      else this.wsByIp.set(ip, a);
    94	      if (b <= 0) this.wsByToken.delete(tokenKey);
    95	      else this.wsByToken.set(tokenKey, b);
    96	    };
    97	  }
    98	
    99	  tryHello(connId: string): boolean {
   100	    return this.hitWindow(this.hellos, connId, this.cfg.hellosPerConnPerMin);
   101	  }
   102	
   103	  get helloTimeoutMs(): number {
   104	    return this.cfg.helloTimeoutMs;
   105	  }
   106	
   107	  /** Test helper */
   108	  snapshot() {
   109	    return {
   110	      wsByIp: Object.fromEntries(this.wsByIp),
   111	      wsByToken: Object.fromEntries(this.wsByToken),
   112	    };
   113	  }
   114	}
FILE apps/proxy/src/server.ts
     1	import http from "node:http";
     2	import { WebSocketServer, WebSocket } from "ws";
     3	import {
     4	  ProxyConfig,
     5	  checkAuth,
     6	  checkOrigin,
     7	  assertDestinationAllowed,
     8	  safeEqual,
     9	} from "./policy.js";
    10	import { AbuseLimiter, defaultLimits, normalizeIp } from "./limits.js";
    11	import { bridgeWsToMud } from "./bridge.js";
    12	
    13	type HelloMsg = {
    14	  type: "hello";
    15	  token?: string;
    16	  host?: string;
    17	  port?: number;
    18	  cols?: number;
    19	  rows?: number;
    20	};
    21	
    22	function clamp(n: number, lo: number, hi: number, fallback: number): number {
    23	  if (!Number.isFinite(n)) return fallback;
    24	  return Math.min(hi, Math.max(lo, Math.trunc(n)));
    25	}
    26	
    27	export function createProxyServer(cfg: ProxyConfig): http.Server {
    28	  const limits = new AbuseLimiter(defaultLimits(cfg.mode));
    29	  let connSeq = 0;
    30	
    31	  const server = http.createServer((req, res) => {
    32	    if (req.url === "/health") {
    33	      res.writeHead(200, {
    34	        "content-type": "application/json",
    35	        "x-content-type-options": "nosniff",
    36	      });
    37	      res.end(JSON.stringify({ ok: true, mode: cfg.mode }));
    38	      return;
    39	    }
    40	    res.writeHead(404);
    41	    res.end("not found");
    42	  });
    43	
    44	  const wss = new WebSocketServer({ noServer: true, maxPayload: 64 * 1024 });
    45	
    46	  server.on("upgrade", (req, socket, head) => {
    47	    try {
    48	      const hostHdr = req.headers.host ?? "localhost";
    49	      const url = new URL(req.url ?? "/", `http://${hostHdr}`);
    50	      if (url.pathname !== "/ws") {
    51	        socket.write("HTTP/1.1 404 Not Found\r\n\r\n");
    52	        socket.destroy();
    53	        return;
    54	      }
    55	
    56	      const ip = normalizeIp(req.socket.remoteAddress);
    57	      if (!limits.tryUpgrade(ip)) {
    58	        socket.write("HTTP/1.1 429 Too Many Requests\r\n\r\n");
    59	        socket.destroy();
    60	        return;
    61	      }
    62	
    63	      const origin = req.headers.origin;
    64	      if (!checkOrigin(origin, cfg)) {
    65	        socket.write("HTTP/1.1 403 Forbidden\r\n\r\n");
    66	        socket.destroy();
    67	        return;
    68	      }
    69	
    70	      // Optional pre-auth via Bearer / cookie / (dev-only) query — still re-checked on hello
    71	      const preAuth = checkAuth(url, cfg, req.headers.cookie, req.headers.authorization);
    72	
    73	      wss.handleUpgrade(req, socket, head, (ws) => {
    74	        const connId = `${ip}:${++connSeq}`;
    75	        const timer = setTimeout(() => {
    76	          if (ws.readyState === WebSocket.OPEN) {
    77	            ws.close(1008, "hello timeout");
    78	          }
    79	        }, limits.helloTimeoutMs);
    80	
    81	        let release: (() => void) | null = null;
    82	        ws.on("close", () => {
    83	          release?.();
    84	          release = null;
    85	        });
    86	
    87	        ws.once("message", async (data) => {
    88	          clearTimeout(timer);
    89	          try {
    90	            if (!limits.tryHello(connId)) {
    91	              ws.close(1008, "hello rate");
    92	              return;
    93	            }
    94	            const text = typeof data === "string" ? data : data.toString("utf8");
    95	            const msg = JSON.parse(text) as HelloMsg;
    96	            if (msg.type !== "hello") {
    97	              ws.close(1008, "expected hello");
    98	              return;
    99	            }
   100	
   101	            // Auth: Bearer/cookie pre-auth OR hello.token (never rely on query in remote-prod)
   102	            let authed = preAuth;
   103	            if (!authed && msg.token && cfg.authToken) {
   104	              authed = safeEqual(msg.token, cfg.authToken);
   105	            }
   106	            if (cfg.mode === "localhost-dev" && !cfg.authToken) {
   107	              authed = true;
   108	            }
   109	            if (!authed) {
   110	              ws.close(1008, "unauthorized");
   111	              return;
   112	            }
   113	
   114	            const tokenKey =
   115	              cfg.authToken && msg.token && safeEqual(msg.token, cfg.authToken)
   116	                ? "tok"
   117	                : preAuth
   118	                  ? "pre"
   119	                  : "anon";
   120	            release = limits.tryAcquire(ip, tokenKey);
   121	            if (!release) {
   122	              ws.close(1008, "concurrency limit");
   123	              return;
   124	            }
   125	
   126	            const mudHost = msg.host ?? "mud.revivalworld.org";
   127	            const mudPort = clamp(Number(msg.port ?? 4000), 1, 65535, 4000);
   128	            const dest = await assertDestinationAllowed(mudHost, mudPort, cfg);
   129	            if (!dest.ok) {
   130	              ws.send(JSON.stringify({ type: "error", message: dest.reason }));
   131	              ws.close(1008, "destination denied");
   132	              return;
   133	            }
   134	
   135	            const cols = clamp(Number(msg.cols ?? 80), 1, 511, 80);
   136	            const rows = clamp(Number(msg.rows ?? 24), 1, 511, 24);
   137	
   138	            ws.send(JSON.stringify({ type: "ready", host: mudHost, port: mudPort }));
   139	            bridgeWsToMud(ws, {
   140	              host: dest.address,
   141	              port: mudPort,
   142	              cols,
   143	              rows,
   144	            });
   145	          } catch {
   146	            ws.close(1008, "bad hello");
   147	          }
   148	        });
   149	      });
   150	    } catch {
   151	      socket.destroy();
   152	    }
   153	  });
   154	
   155	  return server;
   156	}
