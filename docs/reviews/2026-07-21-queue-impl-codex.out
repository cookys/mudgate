   131	export type TermFontConfig = {
   132	  presetId: string;
   133	  primary: string;
   134	  extras: string[];
   135	  useDefaultTcChain: boolean;
   136	  fontSizePx: number;
   137	  cellWidthScale: number;
   138	  lineHeightScale: number;
   139	  letterSpacingPx: number;
   140	  ligatures: boolean;
   141	};
   142	
   143	export const DEFAULT_TERM_FONT: TermFontConfig = {
   144	  presetId: "sarasa-term-tc",
   145	  primary: "Sarasa Term TC",
   146	  extras: [],
   147	  useDefaultTcChain: true,
   148	  fontSizePx: 15,
   149	  cellWidthScale: 1,
   150	  lineHeightScale: 1.2,
   151	  letterSpacingPx: 0,
   152	  ligatures: false,
   153	};
   154	
   155	const STORAGE_KEY = "assmud.termFont";
   156	
   157	export function loadTermFont(): TermFontConfig {
   158	  try {
   159	    const raw = localStorage.getItem(STORAGE_KEY);
   160	    if (!raw) return { ...DEFAULT_TERM_FONT };
   161	    const j = JSON.parse(raw) as Partial<TermFontConfig>;
   162	    return { ...DEFAULT_TERM_FONT, ...j };
   163	  } catch {
   164	    return { ...DEFAULT_TERM_FONT };
   165	  }
   166	}
   167	
   168	export function saveTermFont(cfg: TermFontConfig): void {
   169	  try {
   170	    localStorage.setItem(STORAGE_KEY, JSON.stringify(cfg));
   171	  } catch {
   172	    /* private mode */
   173	  }
   174	}
   175	
   176	/**
   177	 * Resolve CSS font-family stack: primary → extras → TC chain → monospace.
   178	 * When `probe` is true (browser), if primary fails CJK glyph probe and
   179	 * chain was disabled, force TC chain so missing CJK still falls back.
   180	 */
   181	export function resolveFontStack(
   182	  cfg: TermFontConfig,
   183	  localeHint: "zh-TW" | "zh-CN" | "en" = "zh-TW",
   184	  opts?: { probe?: boolean },
   185	): string {
   186	  let chain: string[] =
   187	    cfg.useDefaultTcChain === false
   188	      ? []
   189	      : localeHint === "zh-CN"
   190	        ? [...SC_FALLBACK_CHAIN]
   191	        : [...TC_FALLBACK_CHAIN];
   192	
   193	  const primary = cfg.primary;
   194	  if (opts?.probe && typeof document !== "undefined" && primary) {
   195	    const p = probeCjkGlyph(primary.includes(" ") ? `"${primary}"` : primary);
   196	    if (!p.ok && chain.length === 0) {
   197	      chain = [
   198	        ...(localeHint === "zh-CN" ? SC_FALLBACK_CHAIN : TC_FALLBACK_CHAIN),
   199	      ];
   200	    }
   201	  }
   202	
   203	  const parts = [primary, ...cfg.extras, ...chain, "ui-monospace", "monospace"]
   204	    .map((s) => s.trim())
   205	    .filter(Boolean);
   206	  const quoted = parts.map((f) =>
   207	    f.includes(" ") && !f.startsWith('"') ? `"${f}"` : f,
   208	  );
   209	  const seen = new Set<string>();
   210	  const out: string[] = [];
   211	  for (const f of quoted) {
   212	    const k = f.toLowerCase();
   213	    if (seen.has(k)) continue;
   214	    seen.add(k);
   215	    out.push(f);
   216	  }
   217	  return out.join(", ");
   218	}
   219	
   220	/** Probe-driven stack used by UI (browser only). */
   221	export function resolveFontStackProbed(
   222	  cfg: TermFontConfig,
   223	  localeHint: "zh-TW" | "zh-CN" | "en" = "zh-TW",
   224	): string {
   225	  return resolveFontStack(cfg, localeHint, { probe: true });
   226	}
   227	
   228	export function applyPreset(id: string): TermFontConfig {
   229	  const e = STATIC_CATALOG.find((x) => x.id === id);
   230	  if (!e || id === "custom") {
   231	    return { ...loadTermFont(), presetId: "custom" };
   232	  }
   233	  return {
   234	    ...DEFAULT_TERM_FONT,
   235	    ...loadTermFont(),
   236	    presetId: id,
   237	    primary: e.families[0] ?? DEFAULT_TERM_FONT.primary,
   238	    useDefaultTcChain: e.latinOnly ? true : loadTermFont().useDefaultTcChain,
   239	  };
   240	}
