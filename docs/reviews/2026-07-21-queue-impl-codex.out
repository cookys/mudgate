    27	export function createProxyServer(cfg: ProxyConfig): http.Server {
    28	  const limits = new AbuseLimiter(defaultLimits(cfg.mode));
    29	  let connSeq = 0;
    30	
    31	  const server = http.createServer((req, res) => {
    32	    if (req.url === "/health") {
    33	      res.writeHead(200, {
    34	        "content-type": "application/json",
    35	        "x-content-type-options": "nosniff",
    36	      });
    37	      res.end(JSON.stringify({ ok: true, mode: cfg.mode }));
    38	      return;
    39	    }
    40	    res.writeHead(404);
    41	    res.end("not found");
    42	  });
    43	
    44	  const wss = new WebSocketServer({ noServer: true, maxPayload: 64 * 1024 });
    45	
    46	  server.on("upgrade", (req, socket, head) => {
    47	    try {
    48	      const hostHdr = req.headers.host ?? "localhost";
    49	      const url = new URL(req.url ?? "/", `http://${hostHdr}`);
    50	      if (url.pathname !== "/ws") {
    51	        socket.write("HTTP/1.1 404 Not Found\r\n\r\n");
    52	        socket.destroy();
    53	        return;
    54	      }
    55	
    56	      const ip = normalizeIp(req.socket.remoteAddress);
    57	      if (!limits.tryUpgrade(ip)) {
    58	        socket.write("HTTP/1.1 429 Too Many Requests\r\n\r\n");
    59	        socket.destroy();
    60	        return;
    61	      }
    62	
    63	      const origin = req.headers.origin;
    64	      if (!checkOrigin(origin, cfg)) {
    65	        socket.write("HTTP/1.1 403 Forbidden\r\n\r\n");
    66	        socket.destroy();
    67	        return;
    68	      }
    69	
    70	      // Optional pre-auth via Bearer / cookie / (dev-only) query — still re-checked on hello
    71	      const preAuth = checkAuth(url, cfg, req.headers.cookie, req.headers.authorization);
    72	
    73	      wss.handleUpgrade(req, socket, head, (ws) => {
    74	        const connId = `${ip}:${++connSeq}`;
    75	        const timer = setTimeout(() => {
    76	          if (ws.readyState === WebSocket.OPEN) {
    77	            ws.close(1008, "hello timeout");
    78	          }
    79	        }, limits.helloTimeoutMs);
    80	
    81	        let release: (() => void) | null = null;
    82	        ws.on("close", () => {
    83	          release?.();
    84	          release = null;
    85	        });
    86	
    87	        ws.once("message", async (data) => {
    88	          clearTimeout(timer);
    89	          try {
    90	            if (!limits.tryHello(connId)) {
    91	              ws.close(1008, "hello rate");
    92	              return;
    93	            }
    94	            const text = typeof data === "string" ? data : data.toString("utf8");
    95	            const msg = JSON.parse(text) as HelloMsg;
    96	            if (msg.type !== "hello") {
    97	              ws.close(1008, "expected hello");
    98	              return;
    99	            }
   100	
   101	            // Auth: Bearer/cookie pre-auth OR hello.token (never rely on query in remote-prod)
   102	            let authed = preAuth;
   103	            if (!authed && msg.token && cfg.authToken) {
   104	              authed = safeEqual(msg.token, cfg.authToken);
   105	            }
   106	            if (cfg.mode === "localhost-dev" && !cfg.authToken) {
   107	              authed = true;
   108	            }
   109	            if (!authed) {
   110	              ws.close(1008, "unauthorized");
   111	              return;
   112	            }
   113	
   114	            const tokenKey =
   115	              cfg.authToken && msg.token && safeEqual(msg.token, cfg.authToken)
   116	                ? "tok"
   117	                : preAuth
   118	                  ? "pre"
   119	                  : "anon";
   120	            release = limits.tryAcquire(ip, tokenKey);
   121	            if (!release) {
   122	              ws.close(1008, "concurrency limit");
   123	              return;
   124	            }
   125	
   126	            const mudHost = msg.host ?? "mud.revivalworld.org";
   127	            const mudPort = clamp(Number(msg.port ?? 4000), 1, 65535, 4000);
   128	            const dest = await assertDestinationAllowed(mudHost, mudPort, cfg);
   129	            if (!dest.ok) {
   130	              ws.send(JSON.stringify({ type: "error", message: dest.reason }));
   131	              ws.close(1008, "destination denied");
   132	              return;
   133	            }
   134	
   135	            const cols = clamp(Number(msg.cols ?? 80), 1, 511, 80);
   136	            const rows = clamp(Number(msg.rows ?? 24), 1, 511, 24);
   137	
   138	            ws.send(JSON.stringify({ type: "ready", host: mudHost, port: mudPort }));
   139	            bridgeWsToMud(ws, {
   140	              host: dest.address,
   141	              port: mudPort,
   142	              cols,
   143	              rows,
   144	            });
   145	          } catch {
   146	            ws.close(1008, "bad hello");
   147	          }
   148	        });
   149	      });
   150	    } catch {
   151	      socket.destroy();
   152	    }
   153	  });
   154	
   155	  return server;
   156	}
     1	import net from "node:net";
     2	import zlib from "node:zlib";
     3	import type WebSocket from "ws";
     4	import {
     5	  TelnetParser,
     6	  replyToNegotiation,
     7	  ttypeIs,
     8	  naws,
     9	  OPT,
    10	  type TelnetEvent,
    11	} from "@assmud/protocol";
    12	
    13	export type BridgeOptions = {
    14	  host: string;
    15	  port: number;
    16	  cols?: number;
    17	  rows?: number;
    18	  /** DO MCCP2 when server WILL (default true) */
    19	  mccp?: boolean;
    20	  maxInflatedPerWindow?: number;
    21	  maxInflatedSession?: number;
    22	  maxCompressedWireSession?: number;
    23	  windowMs?: number;
    24	};
    25	
    26	const MAX_PARSER_FEED = 60_000;
    27	
    28	function envInt(name: string, fallback: number): number {
    29	  const v = process.env[name];
    30	  if (v == null || v === "") return fallback;
    31	  const n = Number(v);
    32	  return Number.isFinite(n) && n > 0 ? Math.floor(n) : fallback;
    33	}
    34	
    35	function escapeIac(buf: Uint8Array): Uint8Array {
    36	  let extra = 0;
    37	  for (let i = 0; i < buf.length; i++) if (buf[i] === 0xff) extra += 1;
    38	  if (!extra) return buf;
    39	  const out = new Uint8Array(buf.length + extra);
    40	  let j = 0;
    41	  for (let i = 0; i < buf.length; i++) {
    42	    out[j++] = buf[i]!;
    43	    if (buf[i] === 0xff) out[j++] = 0xff;
    44	  }
    45	  return out;
    46	}
    47	
    48	function addCap(current: number, incoming: number, cap: number): number | null {
    49	  if (incoming > cap - current) return null;
    50	  return current + incoming;
    51	}
    52	
    53	/**
    54	 * Bridge one WebSocket client to one TCP MUD connection.
    55	 * Optional MCCP2: after IAC SB MCCP2 IAC SE, zlib-inflate wire then telnet-parse.
    56	 */
    57	export function bridgeWsToMud(ws: WebSocket, opts: BridgeOptions): void {
    58	  const parser = new TelnetParser();
    59	  const cols = opts.cols ?? 80;
    60	  const rows = opts.rows ?? 24;
    61	  const mccpEnabled =
    62	    opts.mccp ??
    63	    (() => {
    64	      const v = (process.env.ASSMUD_MCCP ?? "1").toLowerCase();
    65	      return !["0", "false", "off", "no"].includes(v);
    66	    })();
    67	
    68	  const WINDOW_MS = opts.windowMs ?? envInt("ASSMUD_MCCP_WINDOW_MS", 60_000);
    69	  const MAX_INFLATED_PER_WINDOW =
    70	    opts.maxInflatedPerWindow ??
    71	    envInt("ASSMUD_MCCP_MAX_WINDOW_BYTES", 16 * 1024 * 1024);
    72	  const MAX_INFLATED_SESSION =
    73	    opts.maxInflatedSession ??
    74	    envInt("ASSMUD_MCCP_MAX_SESSION_BYTES", 256 * 1024 * 1024);
    75	  const MAX_WIRE_SESSION =
    76	    opts.maxCompressedWireSession ??
    77	    envInt("ASSMUD_MCCP_MAX_WIRE_BYTES", 128 * 1024 * 1024);
    78	
    79	  let compressedMode = false;
    80	  let inflate: zlib.Inflate | null = null;
    81	  let inflatedSession = 0;
    82	  let inflatedWindow = 0;
    83	  let windowStart = Date.now();
    84	  let wireSession = 0;
    85	  let closed = false;
    86	  let finishing = false;
    87	  let errorSent = false;
    88	  /** Server ECHO option active → client should mask local input (password). */
    89	  let echoMask = false;
    90	
    91	  const sock = net.connect({ host: opts.host, port: opts.port });
    92	
    93	  const sendJson = (obj: Record<string, unknown>) => {
    94	    if (closed || ws.readyState !== ws.OPEN) return;
    95	    try {
    96	      ws.send(JSON.stringify(obj));
    97	    } catch {
    98	      /* ignore */
    99	    }
   100	  };
   101	
   102	  const setEchoMask = (mask: boolean) => {
   103	    if (echoMask === mask) return;
   104	    echoMask = mask;
   105	    sendJson({ type: "echo", mask });
   106	  };
   107	
   108	  const destroy = (reason: string) => {
   109	    if (closed) return;
   110	    closed = true;
   111	    try {
   112	      inflate?.destroy();
   113	    } catch {
   114	      /* ignore */
   115	    }
   116	    inflate = null;
   117	    if (ws.readyState === ws.OPEN) {
   118	      if (!errorSent) {
   119	        errorSent = true;
   120	        const msg = reason
   121	          .replace(/[^\x20-\x7E\u4e00-\u9fff]/g, "")
   122	          .slice(0, 200);
   123	        try {
   124	          ws.send(JSON.stringify({ type: "error", message: msg || "mccp" }));
   125	        } catch {
   126	          /* ignore */
   127	        }
   128	      }
   129	      try {
   130	        ws.close(1011, "bridge destroy");
   131	      } catch {
   132	        /* ignore */
   133	      }
   134	    }
   135	    try {
   136	      sock.destroy();
   137	    } catch {
   138	      /* ignore */
   139	    }
   140	  };
   141	
   142	  const sendTcp = (buf: Uint8Array) => {
   143	    if (!sock.destroyed) sock.write(Buffer.from(buf));
   144	  };
   145	
   146	  const forwardData = (bytes: Uint8Array) => {
   147	    if (closed || ws.readyState !== ws.OPEN || bytes.length === 0) return;
   148	    ws.send(bytes);
   149	  };
   150	
   151	  const handleEvents = (events: TelnetEvent[]) => {
   152	    for (const ev of events) {
   153	      if (ev.type === "data") {
   154	        forwardData(ev.bytes);
   155	      } else if (ev.type === "will") {
   156	        const reply = replyToNegotiation("will", ev.option, {
   157	          mccp: mccpEnabled,
   158	        });
   159	        if (reply) sendTcp(reply);
   160	        if (ev.option === OPT.ECHO) setEchoMask(true);
   161	      } else if (ev.type === "wont") {
   162	        const reply = replyToNegotiation("wont", ev.option, {
   163	          mccp: mccpEnabled,
   164	        });
   165	        if (reply) sendTcp(reply);
   166	        if (ev.option === OPT.ECHO) setEchoMask(false);
   167	      } else if (ev.type === "do") {
   168	        const reply = replyToNegotiation("do", ev.option, {
   169	          mccp: mccpEnabled,
   170	        });
   171	        if (reply) sendTcp(reply);
   172	        if (ev.option === OPT.NAWS) sendTcp(naws(cols, rows));
   173	        if (ev.option === OPT.ECHO) setEchoMask(true);
   174	      } else if (ev.type === "dont") {
   175	        const reply = replyToNegotiation("dont", ev.option, {
   176	          mccp: mccpEnabled,
   177	        });
   178	        if (reply) sendTcp(reply);
   179	        if (ev.option === OPT.ECHO) setEchoMask(false);
   180	      } else if (ev.type === "sb" && ev.option === OPT.TTYPE) {
   181	        if (ev.payload.length > 0 && ev.payload[0] === 1) {
   182	          sendTcp(ttypeIs("ANSI"));
   183	        }
   184	      }
   185	      // MCCP2 sb start is handled by pushUntilMccpStart boundary, not here
   186	    }
   187	  };
   188	
   189	  const feedDecompressed = (buf: Buffer) => {
   190	    if (closed) return;
   191	    const now = Date.now();
   192	    if (now - windowStart >= WINDOW_MS) {
   193	      windowStart = now;
   194	      inflatedWindow = 0;
   195	    }
   196	    let offset = 0;
   197	    while (offset < buf.length) {
   198	      const slice = buf.subarray(
   199	        offset,
   200	        Math.min(offset + MAX_PARSER_FEED, buf.length),
   201	      );
   202	      offset += slice.length;
   203	
   204	      const nextSess = addCap(inflatedSession, slice.length, MAX_INFLATED_SESSION);
   205	      const nextWin = addCap(inflatedWindow, slice.length, MAX_INFLATED_PER_WINDOW);
   206	      if (nextSess == null || nextWin == null) {
   207	        destroy("mccp inflate cap exceeded");
   208	        return;
   209	      }
   210	      inflatedSession = nextSess;
   211	      inflatedWindow = nextWin;
   212	
   213	      const events = parser.push(new Uint8Array(slice));
   214	      handleEvents(events);
   215	    }
   216	  };
   217	
   218	  const startInflate = (residual: Uint8Array) => {
   219	    inflate = zlib.createInflate();
   220	    inflate.on("data", (d: Buffer) => feedDecompressed(d));
   221	    inflate.on("error", () => destroy("mccp inflate error"));
   222	    // residual is compressed wire
   223	    if (residual.length) {
   224	      const nextWire = addCap(wireSession, residual.length, MAX_WIRE_SESSION);
   225	      if (nextWire == null) {
   226	        destroy("mccp wire cap exceeded");
   227	        return;
   228	      }
   229	      wireSession = nextWire;
   230	      try {
   231	        inflate.write(Buffer.from(residual));
   232	      } catch {
   233	        destroy("mccp inflate write");
   234	      }
   235	    }
   236	  };
   237	
   238	  sock.on("data", (chunk: Buffer) => {
   239	    if (closed) return;
   240	    const u8 = new Uint8Array(chunk);
   241	
   242	    if (!compressedMode) {
   243	      const { events, mccpStarted, residual } = parser.pushUntilMccpStart(u8);
   244	      handleEvents(events);
   245	      if (mccpStarted) {
   246	        if (!mccpEnabled) {
   247	          destroy("mccp se while disabled");
   248	          return;
   249	        }
   250	        compressedMode = true;
   251	        startInflate(residual);
   252	      }
   253	      return;
   254	    }
   255	
   256	    // compressed mode — never TelnetParser on wire
   257	    const nextWire = addCap(wireSession, u8.length, MAX_WIRE_SESSION);
   258	    if (nextWire == null) {
   259	      destroy("mccp wire cap exceeded");
   260	      return;
   261	    }
   262	    wireSession = nextWire;
   263	    try {
   264	      inflate?.write(Buffer.from(u8));
   265	    } catch {
   266	      destroy("mccp inflate write");
   267	    }
   268	  });
   269	
   270	  sock.on("error", (err) => {
   271	    destroy(String(err.message) || "tcp error");
   272	  });
   273	
   274	  const finishInflateThenClose = () => {
   275	    if (closed || finishing) return;
   276	    finishing = true;
   277	    if (inflate && !inflate.destroyed) {
   278	      const z = inflate;
   279	      try {
   280	        z.end();
   281	      } catch {
   282	        destroy("mccp truncated");
   283	        return;
   284	      }
   285	      const okClose = () => {
   286	        if (closed) return;
   287	        closed = true;
   288	        if (ws.readyState === ws.OPEN) ws.close(1000, "mud closed");
   289	      };
   290	      z.once("end", okClose);
   291	      z.once("error", () => destroy("mccp truncated"));
   292	      // hung inflate ≠ success
   293	      setTimeout(() => {
   294	        if (!closed) destroy("mccp truncated");
   295	      }, 2000);
   296	      return;
   297	    }
   298	    closed = true;
   299	    if (ws.readyState === ws.OPEN) ws.close(1000, "mud closed");
   300	  };
   301	
   302	  sock.on("end", finishInflateThenClose);
   303	  sock.on("close", () => {
   304	    if (!closed && !finishing) finishInflateThenClose();
   305	  });
   306	
   307	  ws.on("message", (data, isBinary) => {
   308	    if (closed) return;
   309	    if (!isBinary) {
   310	      const s = String(data);
   311	      if (s.length > 16_384) return;
   312	      const cleaned = s.replace(/\xff/g, "");
   313	      const line =
   314	        cleaned.endsWith("\n") || cleaned.endsWith("\r")
   315	          ? cleaned
   316	          : cleaned + "\r\n";
   317	      sendTcp(new TextEncoder().encode(line));
   318	      return;
   319	    }
   320	    const buf = new Uint8Array(data as Buffer);
   321	    if (buf.length > 16_384) return;
   322	    sendTcp(escapeIac(buf));
   323	  });
   324	
   325	  ws.on("close", () => {
   326	    closed = true;
   327	    try {
   328	      inflate?.destroy();
   329	    } catch {
   330	      /* ignore */
   331	    }
   332	    sock.destroy();
   333	  });
   334	}
     1	/** Connection profiles (Phase 4) — no secrets required; token optional. */
     2	
     3	export type { WidthMode, NormalizedCharset, WidthModeSource } from "./widthMode.js";
     4	export {
     5	  normalizeCharset,
     6	  resolveWidthMode,
     7	} from "./widthMode.js";
     8	export {
     9	  loadProfileSecrets,
    10	  saveProfileSecrets,
    11	  setProfilePassword,
    12	  getProfilePassword,
    13	  clearProfileSecret,
    14	  type ProfileSecrets,
    15	} from "./secrets.js";
    16	import type { WidthMode } from "./widthMode.js";
    17	
    18	export type MudCharset = "big5hkscs" | "big5" | "utf8" | "gbk";
    19	
    20	export type MudProfile = {
    21	  id: string;
    22	  name: string;
    23	  host: string;
    24	  port: number;
    25	  charset: MudCharset;
    26	  /** Optional cell-width override; omit to derive from charset. */
    27	  widthMode?: WidthMode;
    28	  tlsToMud?: boolean;
    29	  notes?: string;
    30	};
    31	
    32	const CHARSETS = new Set<MudCharset>(["big5hkscs", "big5", "utf8", "gbk"]);
    33	
    34	/** Strict validate one profile object. */
    35	export function validateProfile(p: unknown): MudProfile {
    36	  if (!p || typeof p !== "object") throw new Error("profile not object");
    37	  const o = p as Record<string, unknown>;
    38	  if (typeof o.id !== "string" || !o.id.trim()) throw new Error("id required");
    39	  if (typeof o.name !== "string" || !o.name.trim())
    40	    throw new Error("name required");
    41	  if (typeof o.host !== "string" || !o.host.trim())
    42	    throw new Error("host required");
    43	  const port = Number(o.port);
    44	  if (!Number.isInteger(port) || port < 1 || port > 65535)
    45	    throw new Error("port 1-65535");
    46	  const charset = String(o.charset ?? "big5hkscs") as MudCharset;
    47	  if (!CHARSETS.has(charset)) throw new Error("invalid charset");
    48	  return sanitizeProfileForExport({
    49	    id: o.id.trim(),
    50	    name: o.name.trim(),
    51	    host: o.host.trim(),
    52	    port,
    53	    charset,
    54	    widthMode:
    55	      o.widthMode === "cjk" || o.widthMode === "western"
    56	        ? o.widthMode
    57	        : undefined,
    58	    tlsToMud: Boolean(o.tlsToMud) || undefined,
    59	    notes: typeof o.notes === "string" ? o.notes : undefined,
    60	  } as MudProfile & Record<string, unknown>);
    61	}
    62	
    63	const KEY = "assmud.profiles.v1";
    64	
    65	export const DEFAULT_PROFILES: MudProfile[] = [
    66	  {
    67	    id: "rw-4000",
    68	    name: "Revival World",
    69	    host: "mud.revivalworld.org",
    70	    port: 4000,
    71	    charset: "big5hkscs",
    72	  },
    73	  {
    74	    id: "rw-5000",
    75	    name: "Revival World (5000)",
    76	    host: "mud.revivalworld.org",
    77	    port: 5000,
    78	    charset: "big5hkscs",
    79	  },
    80	  {
    81	    id: "rw-6000",
    82	    name: "Revival World (6000)",
    83	    host: "mud.revivalworld.org",
    84	    port: 6000,
    85	    charset: "big5hkscs",
    86	  },
    87	];
    88	
    89	export function loadProfiles(): MudProfile[] {
    90	  if (typeof localStorage === "undefined") return [...DEFAULT_PROFILES];
    91	  try {
    92	    const raw = localStorage.getItem(KEY);
    93	    if (!raw) return [...DEFAULT_PROFILES];
    94	    const parsed = JSON.parse(raw) as MudProfile[];
    95	    return parsed.length ? parsed : [...DEFAULT_PROFILES];
    96	  } catch {
    97	    return [...DEFAULT_PROFILES];
    98	  }
    99	}
   100	
   101	export function saveProfiles(list: MudProfile[]): void {
   102	  if (typeof localStorage === "undefined") return;
   103	  localStorage.setItem(KEY, JSON.stringify(list));
   104	}
   105	
   106	const SECRET_KEYS = new Set([
   107	  "proxyToken",
   108	  "assmud_token",
   109	  "password",
   110	  "token",
   111	  "secret",
   112	]);
   113	
   114	/** Strip secret-like keys; never re-export imported credentials. */
   115	export function sanitizeProfileForExport(
   116	  p: MudProfile & Record<string, unknown>,
   117	): MudProfile {
   118	  const out: Record<string, unknown> = {};
   119	  for (const [k, v] of Object.entries(p)) {
   120	    if (SECRET_KEYS.has(k)) continue;
   121	    out[k] = v;
   122	  }
   123	  return out as unknown as MudProfile;
   124	}
   125	
   126	export function exportProfilesJson(list: MudProfile[]): string {
   127	  const clean = list.map((p) =>
   128	    sanitizeProfileForExport(p as MudProfile & Record<string, unknown>),
   129	  );
   130	  return JSON.stringify(clean, null, 2);
   131	}
   132	
   133	export function importProfilesJson(json: string): MudProfile[] {
   134	  let list: unknown;
   135	  try {
   136	    list = JSON.parse(json);
   137	  } catch {
   138	    throw new Error("invalid profiles JSON");
   139	  }
   140	  if (!Array.isArray(list)) throw new Error("invalid profiles");
   141	  if (list.length === 0) throw new Error("empty profiles");
   142	  return list.map((p) => validateProfile(p));
   143	}
     1	/** Profile secrets store — separate from exportable profiles. */
     2	
     3	const KEY = "assmud.profileSecrets";
     4	
     5	export type ProfileSecrets = Record<
     6	  string,
     7	  { password?: string; notes?: string }
     8	>;
     9	
    10	/** Node / tests without DOM: in-memory store. */
    11	let memoryStore: ProfileSecrets = {};
    12	
    13	export function loadProfileSecrets(): ProfileSecrets {
    14	  if (typeof localStorage === "undefined") {
    15	    return { ...memoryStore };
    16	  }
    17	  try {
    18	    const raw = localStorage.getItem(KEY);
    19	    if (!raw) return {};
    20	    const j = JSON.parse(raw) as ProfileSecrets;
    21	    return j && typeof j === "object" ? j : {};
    22	  } catch {
    23	    return {};
    24	  }
    25	}
    26	
    27	export function saveProfileSecrets(s: ProfileSecrets): void {
    28	  if (typeof localStorage === "undefined") {
    29	    memoryStore = { ...s };
    30	    return;
    31	  }
    32	  localStorage.setItem(KEY, JSON.stringify(s));
    33	}
    34	
    35	export function setProfilePassword(profileId: string, password: string): void {
    36	  const s = loadProfileSecrets();
    37	  s[profileId] = { ...s[profileId], password };
    38	  saveProfileSecrets(s);
    39	}
    40	
    41	export function getProfilePassword(profileId: string): string | undefined {
    42	  return loadProfileSecrets()[profileId]?.password;
    43	}
    44	
    45	export function clearProfileSecret(profileId: string): void {
    46	  const s = loadProfileSecrets();
    47	  delete s[profileId];
    48	  saveProfileSecrets(s);
    49	}
     1	import { useState } from "react";
     2	import type { MudProfile } from "@assmud/profiles";
     3	import {
     4	  getProfilePassword,
     5	  setProfilePassword,
     6	  clearProfileSecret,
     7	  validateProfile,
     8	} from "@assmud/profiles";
     9	
    10	type Props = {
    11	  profiles: MudProfile[];
    12	  selectedId: string;
    13	  onChange: (list: MudProfile[]) => void;
    14	  onSelect: (id: string) => void;
    15	};
    16	
    17	const emptyDraft = (): Partial<MudProfile> => ({
    18	  id: "",
    19	  name: "",
    20	  host: "",
    21	  port: 4000,
    22	  charset: "big5hkscs",
    23	});
    24	
    25	export function ProfileEditor({
    26	  profiles,
    27	  selectedId,
    28	  onChange,
    29	  onSelect,
    30	}: Props) {
    31	  const selected = profiles.find((p) => p.id === selectedId);
    32	  const [draft, setDraft] = useState<Partial<MudProfile>>(
    33	    () => selected ?? emptyDraft(),
    34	  );
    35	  const [password, setPassword] = useState(() =>
    36	    selected ? getProfilePassword(selected.id) ?? "" : "",
    37	  );
    38	  const [err, setErr] = useState<string | null>(null);
    39	  const [mode, setMode] = useState<"view" | "edit" | "create">("view");
    40	
    41	  const startCreate = () => {
    42	    setMode("create");
    43	    setDraft(emptyDraft());
    44	    setPassword("");
    45	    setErr(null);
    46	  };
    47	
    48	  const startEdit = () => {
    49	    if (!selected) return;
    50	    setMode("edit");
    51	    setDraft({ ...selected });
    52	    setPassword(getProfilePassword(selected.id) ?? "");
    53	    setErr(null);
    54	  };
    55	
    56	  const cancel = () => {
    57	    setMode("view");
    58	    setErr(null);
    59	    if (selected) {
    60	      setDraft({ ...selected });
    61	      setPassword(getProfilePassword(selected.id) ?? "");
    62	    }
    63	  };
    64	
    65	  const save = () => {
    66	    try {
    67	      const p = validateProfile({
    68	        ...draft,
    69	        id: draft.id || `p-${Date.now()}`,
    70	        name: draft.name || draft.host || "unnamed",
    71	      });
    72	      let next: MudProfile[];
    73	      if (mode === "create") {
    74	        if (profiles.some((x) => x.id === p.id)) {
    75	          throw new Error("id already exists");
    76	        }
    77	        next = [...profiles, p];
    78	      } else {
    79	        next = profiles.map((x) => (x.id === selectedId ? p : x));
    80	      }
    81	      onChange(next);
    82	      if (password) setProfilePassword(p.id, password);
    83	      else clearProfileSecret(p.id);
    84	      onSelect(p.id);
    85	      setMode("view");
    86	      setErr(null);
    87	    } catch (e) {
    88	      setErr(e instanceof Error ? e.message : "invalid");
    89	    }
    90	  };
    91	
    92	  const remove = () => {
    93	    if (!selected || profiles.length <= 1) return;
    94	    clearProfileSecret(selected.id);
    95	    const next = profiles.filter((p) => p.id !== selected.id);
    96	    onChange(next);
    97	    onSelect(next[0]!.id);
    98	    setMode("view");
    99	  };
   100	
   101	  if (mode === "view") {
   102	    return (
   103	      <div className="space-y-2">
   104	        <div className="flex flex-wrap gap-2">
   105	          <button
   106	            type="button"
   107	            className="text-xs rounded border px-2 py-1"
   108	            style={{ borderColor: "var(--border)", color: "var(--text)" }}
   109	            onClick={startCreate}
   110	          >
   111	            + New profile
   112	          </button>
   113	          <button
   114	            type="button"
   115	            className="text-xs rounded border px-2 py-1"
   116	            style={{ borderColor: "var(--border)", color: "var(--text)" }}
   117	            onClick={startEdit}
   118	            disabled={!selected}
   119	          >
   120	            Edit
   121	          </button>
   122	          <button
   123	            type="button"
   124	            className="text-xs rounded border px-2 py-1"
   125	            style={{ borderColor: "var(--danger)", color: "var(--danger)" }}
   126	            onClick={remove}
   127	            disabled={!selected || profiles.length <= 1}
   128	          >
   129	            Delete
   130	          </button>
   131	        </div>
   132	        {selected && (
   133	          <p className="text-[11px] font-mono" style={{ color: "var(--text-faint)" }}>
   134	            {selected.host}:{selected.port} · {selected.charset}
   135	            {getProfilePassword(selected.id) ? " · 🔑 secret stored" : ""}
   136	          </p>
   137	        )}
   138	      </div>
   139	    );
   140	  }
   141	
   142	  return (
   143	    <div className="space-y-2 rounded border p-2" style={{ borderColor: "var(--border)" }}>
   144	      <div className="text-xs font-medium" style={{ color: "var(--text)" }}>
   145	        {mode === "create" ? "New profile" : "Edit profile"}
   146	      </div>
   147	      {(
   148	        [
   149	          ["id", "id"],
   150	          ["name", "name"],
   151	          ["host", "host"],
   152	          ["port", "port"],
   153	          ["charset", "charset"],
   154	        ] as const
   155	      ).map(([key, label]) => (
   156	        <label
   157	          key={key}
   158	          className="block text-[11px]"
   159	          style={{ color: "var(--text-dim)" }}
   160	        >
   161	          {label}
   162	          <input
   163	            className="mt-0.5 w-full rounded border px-2 py-1 font-mono text-xs"
   164	            style={{
   165	              background: "var(--bg-elevated)",
   166	              borderColor: "var(--border)",
   167	              color: "var(--text)",
   168	            }}
   169	            disabled={mode === "edit" && key === "id"}
   170	            value={String(draft[key] ?? "")}
   171	            onChange={(e) =>
   172	              setDraft((d) => ({
   173	                ...d,
   174	                [key]:
   175	                  key === "port" ? Number(e.target.value) : e.target.value,
   176	              }))
   177	            }
   178	          />
   179	        </label>
   180	      ))}
   181	      <label className="block text-[11px]" style={{ color: "var(--text-dim)" }}>
   182	        Auto-login password (local only, not exported)
   183	        <input
   184	          type="password"
   185	          className="mt-0.5 w-full rounded border px-2 py-1 font-mono text-xs"
   186	          style={{
   187	            background: "var(--bg-elevated)",
   188	            borderColor: "var(--border)",
   189	            color: "var(--text)",
   190	          }}
   191	          value={password}
   192	          onChange={(e) => setPassword(e.target.value)}
   193	          autoComplete="off"
   194	        />
   195	      </label>
   196	      {err && (
   197	        <p className="text-[11px]" style={{ color: "var(--danger)" }}>
   198	          {err}
   199	        </p>
   200	      )}
   201	      <div className="flex gap-2">
   202	        <button
   203	          type="button"
   204	          className="text-xs rounded px-2 py-1 font-semibold"
   205	          style={{ background: "var(--accent)", color: "#0a0b0e" }}
   206	          onClick={save}
   207	        >
   208	          Save
   209	        </button>
   210	        <button
   211	          type="button"
   212	          className="text-xs rounded border px-2 py-1"
   213	          style={{ borderColor: "var(--border)", color: "var(--text)" }}
   214	          onClick={cancel}
   215	        >
   216	          Cancel
   217	        </button>
   218	      </div>
   219	    </div>
   220	  );
   221	}
