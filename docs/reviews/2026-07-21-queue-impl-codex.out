     1	#!/usr/bin/env bash
     2	# Lightweight secret scan — blocking for CI. Prefer gitleaks when available.
     3	set -euo pipefail
     4	ROOT="$(cd "$(dirname "$0")/.." && pwd)"
     5	cd "$ROOT"
     6	
     7	if command -v gitleaks >/dev/null 2>&1; then
     8	  gitleaks detect --source . --no-git -v
     9	  exit $?
    10	fi
    11	
    12	# Fallback: ripgrep-style patterns on tracked-ish paths (no node_modules)
    13	PATTERN='(AKIA[0-9A-Z]{16}|-----BEGIN (RSA |OPENSSH )?PRIVATE KEY-----|api[_-]?key\s*[:=]\s*['\''"][^'\''"]{16,}|ASSMUD_AUTH_TOKEN\s*=\s*["'\''][a-f0-9]{20,})'
    14	if command -v rg >/dev/null 2>&1; then
    15	  if rg -n --hidden -g '!node_modules' -g '!.git' -g '!*.out' -g '!docs/reviews/*' -g '!package-lock.json' "$PATTERN" . ; then
    16	    echo "secret-scan: potential secrets found (see matches above)" >&2
    17	    exit 1
    18	  fi
    19	else
    20	  if grep -RInE --exclude-dir=node_modules --exclude-dir=.git --exclude='*.out' --exclude='package-lock.json' "$PATTERN" . 2>/dev/null; then
    21	    echo "secret-scan: potential secrets found" >&2
    22	    exit 1
    23	  fi
    24	fi
    25	echo "secret-scan: ok (fallback patterns; install gitleaks for full coverage)"
