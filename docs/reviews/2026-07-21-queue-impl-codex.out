     5	import { describe, it, expect } from "vitest";
     6	import { readFileSync } from "node:fs";
     7	import { join, dirname } from "node:path";
     8	import { fileURLToPath } from "node:url";
     9	import zlib from "node:zlib";
    10	import net from "node:net";
    11	import {
    12	  TelnetParser,
    13	  IAC,
    14	  WILL,
    15	  OPT,
    16	  DO,
    17	  SB,
    18	  SE,
    19	  replyToNegotiation,
    20	} from "@assmud/protocol";
    21	import { Big5StreamDecoder } from "@assmud/codec-big5";
    22	import { ScreenBuffer } from "@assmud/terminal";
    23	
    24	const root = join(dirname(fileURLToPath(import.meta.url)), "../..");
    25	
    26	function readAll(sock: net.Socket, ms = 500): Promise<Buffer> {
    27	  return new Promise((resolve) => {
    28	    const chunks: Buffer[] = [];
    29	    const t = setTimeout(() => {
    30	      sock.destroy();
    31	      resolve(Buffer.concat(chunks));
    32	    }, ms);
    33	    sock.on("data", (c) => chunks.push(c));
    34	    sock.on("end", () => {
    35	      clearTimeout(t);
    36	      resolve(Buffer.concat(chunks));
    37	    });
    38	  });
    39	}
    40	
    41	/** Same stream path as proxy bridge: boundary parse then createInflate. */
    42	async function inflateAfterMccpStart(
    43	  wireChunks: Uint8Array[],
    44	): Promise<{ preEvents: ReturnType<TelnetParser["push"]>; inflated: Buffer }> {
    45	  const parser = new TelnetParser();
    46	  const inflatedChunks: Buffer[] = [];
    47	  let inflate: zlib.Inflate | null = null;
    48	  let preEvents: ReturnType<TelnetParser["push"]> = [];
    49	
    50	  for (const chunk of wireChunks) {
    51	    if (!inflate) {
    52	      const r = parser.pushUntilMccpStart(chunk);
    53	      preEvents = preEvents.concat(r.events);
    54	      if (r.mccpStarted) {
    55	        inflate = zlib.createInflate();
    56	        inflate.on("data", (d: Buffer) => inflatedChunks.push(d));
    57	        if (r.residual.length) inflate.write(Buffer.from(r.residual));
    58	      }
    59	    } else {
    60	      inflate.write(Buffer.from(chunk));
    61	    }
    62	  }
    63	  await new Promise<void>((resolve, reject) => {
    64	    if (!inflate) {
    65	      resolve();
    66	      return;
    67	    }
    68	    inflate.end();
    69	    inflate.once("end", () => resolve());
    70	    inflate.once("error", reject);
    71	    setTimeout(() => resolve(), 100);
    72	  });
    73	  return { preEvents, inflated: Buffer.concat(inflatedChunks) };
    74	}
    75	
