   243	    return resolveWsUrl(trustMode, {
   244	      envDefault: DEFAULT_WS,
   245	      customWs,
   246	      officialUrl: readOfficialProxyUrl(),
   247	    });
   248	  }, [tab?.connected, trustMode, customWs]);
   249	
   250	  const hello: HelloMsg = useMemo(
   251	    () => ({
   252	      type: "hello",
   253	      token: token || undefined,
   254	      host: profile.host,
   255	      port: profile.port,
   256	      cols: 80,
   257	      rows: 28,
   258	    }),
   259	    [token, profile],
   260	  );
   261	
   262	  const onSendThroughEngine = useCallback((line: string) => {
   263	    const expanded = engine.expandInput(line);
   264	    for (const l of expanded) {
   265	      const dir = l.trim().toLowerCase();
   266	      if (["n", "s", "e", "w", "ne", "nw", "se", "sw", "u", "d"].includes(dir)) {
   267	        clientMap.move(dir as "n", dir);
   268	        setMapAscii(clientMap.ascii(4));
   269	      }
   270	    }
   271	    return expanded;
   272	  }, []);
   273	
   274	  const downloadLog = () => {
   275	    const blob = new Blob([tab.log.join("\n")], { type: "text/plain" });
   276	    const a = document.createElement("a");
   277	    a.href = URL.createObjectURL(blob);
   278	    a.download = `assmud-session-${tab.id}.log`;
   279	    a.click();
   280	  };
   281	
   282	  const exportProfiles = () => {
   283	    const blob = new Blob([exportProfilesJson(profiles)], {
   284	      type: "application/json",
   285	    });
   286	    const a = document.createElement("a");
   287	    a.href = URL.createObjectURL(blob);
   288	    a.download = "assmud-profiles.json";
   289	    a.click();
   290	  };
   291	
   292	  const importProfilesFile = async (file: File) => {
   293	    const text = await file.text();
   294	    const list = importProfilesJson(text);
   295	    setProfiles(list);
   296	    saveProfiles(list);
   297	  };
   298	
   299	  const connectTab = () => {
   300	    setTabs((ts) =>
   301	      ts.map((x) => (x.id === tabId ? { ...x, connected: true } : x)),
   302	    );
   303	  };
   304	
   305	  const disconnectTab = () => {
   306	    setTabs((ts) =>
   307	      ts.map((x) =>
   308	        x.id === tabId ? { ...x, connected: false, status: IDLE } : x,
   309	      ),
   310	    );
   311	  };
   312	
   313	  const submitCmd = (line: string) => {
   314	    const trimmed = line.trim();
   315	    if (!trimmed) return;
   316	    setCmd(trimmed);
   317	    setInputDraft("");
   318	  };
   319	
   320	  // ── Connect gate (pre-session) ─────────────────────────────────────
   321	  if (!anyConnected) {
   322	    return (
   323	      <ConnectGate
   324	        profiles={profiles.length ? profiles : DEFAULT_PROFILES}
   325	        profileId={tab.profileId}
   326	        token={token}
   327	        accent={accent}
   328	        trustMode={trustMode}
   329	        customWs={customWs}
   330	        customAck={customAck}
   331	        onProfile={(id) => {
   332	          setActiveProfile(id);
   333	          setTabs((ts) =>
   334	            ts.map((x) => (x.id === tabId ? { ...x, profileId: id } : x)),
   335	          );
   336	        }}
   337	        onProfilesChange={(list) => {
   338	          setProfiles(list);
   339	          saveProfiles(list);
   340	        }}
   341	        onToken={(tok) => {
   342	          setToken(tok);
   343	          saveProxyToken(tok);
   344	        }}
   345	        onTrustMode={(m) => {
   346	          setTrustMode(m);
   347	          saveTrustMode(m);
   348	          if (m !== "custom") {
   349	            setCustomAck(false);
   350	            saveCustomAck(false);
   351	          }
   352	        }}
   353	        onCustomWs={(u) => {
   354	          setCustomWs(u);
   355	          saveCustomWs(u);
   356	          // URL change clears ack inside saveCustomWs
   357	          setCustomAck(false);
   358	        }}
   359	        onCustomAck={(ok) => {
   360	          setCustomAck(ok);
   361	          saveCustomAck(ok);
   362	        }}
   363	        onAccent={(a) => {
   364	          setAccent(a);
   365	          applyAccent(a);
   366	        }}
   367	        onConnect={connectTab}
   368	        onImportProfiles={(f) => void importProfilesFile(f)}
   369	        onExportProfiles={exportProfiles}
   370	      />
   371	    );
   372	  }
   373	
   374	  // ── Play shell ─────────────────────────────────────────────────────
   375	  return (
   376	    <div
   377	      className="h-full flex flex-col min-h-0"
   378	      style={{ background: "var(--bg-void)" }}
   379	    >
   380	      <FontTrialPanel
   381	        open={fontTrialOpen}
   382	        base={termFont}
   383	        locale={locale}
   384	        onClose={() => setFontTrialOpen(false)}
   385	        onApply={(cfg) => {
   386	          setTermFont(cfg);
   387	          saveTermFont(cfg);
   388	          setFontTrialOpen(false);
   389	        }}
   390	      />
   520	          style={{
