    26	  });
    27	
    28	  it("custom primary appears first in stack", () => {
    29	    const s = resolveFontStack(
    30	      { ...DEFAULT_TERM_FONT, primary: "MyFont", presetId: "custom" },
    31	      "zh-TW",
    32	    );
    33	    expect(s.startsWith("MyFont") || s.startsWith('"MyFont"')).toBe(true);
    34	  });
    35	
    36	  it("probeCjkGlyph is exported and returns structure", () => {
