FILE tests/e2e/mock-mud-server.ts
     1	/** Minimal TCP mock that plays a byte fixture then optional MCCP2 compressed payload. */
     2	import net from "node:net";
     3	import zlib from "node:zlib";
     4	import { IAC, WILL, DO, SB, SE, OPT } from "@assmud/protocol";
     5	
     6	export type MockMudHandle = {
     7	  port: number;
     8	  close: () => Promise<void>;
     9	};
    10	
    11	export async function startMockMud(opts: {
    12	  fixture: Buffer;
    13	  mccp?: boolean;
    14	  compressedPlain?: Buffer;
    15	}): Promise<MockMudHandle> {
    16	  const server = net.createServer((sock) => {
    17	    // IAC preamble: WILL MCCP2 optional
    18	    if (opts.mccp) {
    19	      sock.write(Buffer.from([IAC, WILL, OPT.MCCP2]));
    20	    }
    21	    sock.write(opts.fixture);
    22	    if (opts.mccp && opts.compressedPlain) {
    23	      const z = zlib.deflateSync(opts.compressedPlain);
    24	      sock.write(Buffer.from([IAC, SB, OPT.MCCP2, IAC, SE]));
    25	      sock.write(z);
    26	    }
    27	  });
    28	
    29	  await new Promise<void>((resolve) => {
    30	    server.listen(0, "127.0.0.1", () => resolve());
    31	  });
    32	  const addr = server.address();
    33	  if (!addr || typeof addr === "string") throw new Error("no port");
    34	  return {
    35	    port: addr.port,
    36	    close: () =>
    37	      new Promise((resolve, reject) => {
    38	        server.close((err) => (err ? reject(err) : resolve()));
    39	      }),
    40	  };
    41	}
    42	
    43	export { IAC, WILL, DO, OPT };
