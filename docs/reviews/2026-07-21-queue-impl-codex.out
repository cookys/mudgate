    46	} from "./termFonts/catalog";
    47	
    48	function newTabId(): string {
    49	  return `t${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`;
    50	}
    51	
    52	const DEFAULT_WS =
    53	  import.meta.env.VITE_PROXY_WS ?? "ws://127.0.0.1:7788/ws";
    54	
    55	const IDLE: StatusEvent = { code: "idle" };
    56	
    57	type Tab = {
    58	  id: string;
    59	  profileId: string;
    60	  connected: boolean;
    61	  status: StatusEvent;
    62	  log: string[];
    63	};
    64	
    65	const engine = new ScriptEngine();
    66	try {
    67	  engine.importPackage(JSON.stringify(RW_STARTER_PACK));
    68	} catch {
    69	  /* ignore */
    70	}
    71	const clientMap = new ClientMap();
    72	
    73	function useIsLg() {
    74	  const [lg, setLg] = useState(
    75	    () => typeof window !== "undefined" && window.matchMedia("(min-width: 1024px)").matches,
    76	  );
    77	  useEffect(() => {
    78	    const mq = window.matchMedia("(min-width: 1024px)");
    79	    const fn = () => setLg(mq.matches);
    80	    mq.addEventListener("change", fn);
    81	    return () => mq.removeEventListener("change", fn);
    82	  }, []);
    83	  return lg;
    84	}
    85	
    86	export function App() {
    87	  const t = useT();
    88	  const { locale } = useLocale();
    89	  const [profiles, setProfiles] = useState<MudProfile[]>(() => loadProfiles());
    90	  const [termFont, setTermFont] = useState<TermFontConfig>(() => loadTermFont());
    91	  const fontStack = useMemo(
    92	    () => resolveFontStackProbed(termFont, locale),
    93	    [termFont, locale],
    94	  );
    95	  const [token, setToken] = useState(() => loadProxyToken());
    96	  const [trustMode, setTrustMode] = useState<TrustMode>(() => loadTrustMode());
    97	  const [customWs, setCustomWs] = useState(() => loadCustomWs());
    98	  const [customAck, setCustomAck] = useState(() => loadCustomAck());
    99	  const [fontTrialOpen, setFontTrialOpen] = useState(false);
   100	  const [accent, setAccent] = useState<AccentId>(() => loadAccent());
   101	  const [activeProfile, setActiveProfile] = useState(
   102	    profiles[0]?.id ?? "rw-4000",
   103	  );
   104	  const [tabs, setTabs] = useState<Tab[]>(() => {
   105	    const id = newTabId();
   106	    return [
   107	      {
   108	        id,
   109	        profileId: "rw-4000",
   110	        connected: false,
   111	        status: IDLE,
   112	        log: [],
   113	      },
   114	    ];
   115	  });
   116	  const [tabId, setTabId] = useState(() => tabs[0]?.id ?? "t0");
   117	  const [cmd, setCmd] = useState("");
   118	  const [inputDraft, setInputDraft] = useState("");
   119	  /** Telnet ECHO password-mode — only while server WILL ECHO. */
   120	  const [echoMask, setEchoMask] = useState(false);
   121	  const [mapAscii, setMapAscii] = useState("(move n/s/e/w to map)");
   122	  const [showLog, setShowLog] = useState(false);
   123	  const [drawerOpen, setDrawerOpen] = useState(false);
   124	  const [closeTargetId, setCloseTargetId] = useState<string | null>(null);
   125	  const isLg = useIsLg();
   126	  // Board: map open desktop, closed mobile
   127	  const [mapOpen, setMapOpen] = useState(true);
   128	  useEffect(() => {
   129	    setMapOpen(isLg);
   130	  }, [isLg]);
   131	
   132	  useEffect(() => {
   133	    applyAccent(accent);
   134	  }, [accent]);
   135	
   136	  const tab = tabs.find((t) => t.id === tabId) ?? tabs[0]!;
   137	  const profile =
   138	    profiles.find((p) => p.id === (tab?.profileId ?? activeProfile)) ??
   139	    profiles[0]!;
   140	  const cellWidthMode = useMemo(
   141	    () =>
   142	      resolveWidthMode({
   143	        charset: profile?.charset,
   144	        widthMode: profile?.widthMode,
   145	      }),
   146	    [profile?.charset, profile?.widthMode],
   147	  );
   148	
   149	  const anyConnected = tabs.some((t) => t.connected);
   150	  const closeTarget = closeTargetId
   151	    ? tabs.find((t) => t.id === closeTargetId)
   152	    : undefined;
   153	  const closeTargetName =
   154	    profiles.find((p) => p.id === closeTarget?.profileId)?.name ??
   155	    closeTarget?.id ??
   156	    "session";
   157	
   158	  const requestCloseTab = (id: string) => {
   159	    setCloseTargetId(id);
   160	  };
   161	
   162	  const confirmCloseTab = () => {
   163	    const id = closeTargetId;
   164	    setCloseTargetId(null);
   165	    if (!id) return;
   166	
   167	    setTabs((ts) => {
   168	      const remaining = ts.filter((t) => t.id !== id);
   169	      if (remaining.length === 0) {
   170	        const fresh: Tab = {
   171	          id: newTabId(),
   172	          profileId: activeProfile,
   173	          connected: false,
   174	          status: IDLE,
   175	          log: [],
   176	        };
   177	        // switch after state settles
   178	        queueMicrotask(() => setTabId(fresh.id));
   179	        return [fresh];
   180	      }
   181	      if (tabId === id) {
   182	        const idx = ts.findIndex((t) => t.id === id);
   183	        const fallback =
   184	          remaining[Math.max(0, idx - 1)] ?? remaining[0]!;
   185	        queueMicrotask(() => setTabId(fallback.id));
   186	      }
   187	      return remaining;
   188	    });
   189	  };
   190	
   191	  const tabIdRef = useRef(tabId);
   192	  tabIdRef.current = tabId;
   193	
   194	  // Stable forever — never recreated, so children cannot loop on identity.
   195	  const setTabStatus = useCallback((id: string, status: StatusEvent) => {
   196	    setTabs((ts) => {
   197	      const cur = ts.find((x) => x.id === id);
   198	      if (!cur || statusEventsEqual(cur.status, status)) return ts;
   199	      return ts.map((x) => (x.id === id ? { ...x, status } : x));
   200	    });
   201	  }, []);
   202	
   203	  const handleStatus = useCallback(
   204	    (e: StatusEvent) => {
   205	      setTabStatus(tabIdRef.current, e);
   206	      // connection lifecycle changes should never leave mask stuck
   207	      if (
   208	        e.code === "disconnected" ||
   209	        e.code === "idle" ||
   210	        e.code === "connecting" ||
   211	        e.code === "max_retries" ||
   212	        e.code === "proxy_error" ||
   213	        e.code === "error"
   214	      ) {
   215	        setEchoMask(false);
   216	      }
   217	    },
   218	    [setTabStatus],
   219	  );
   220	
   221	  const handleEchoMask = useCallback((mask: boolean) => {
   222	    setEchoMask(mask);
   223	  }, []);
   224	
   225	  const handleServerLine = useCallback((line: string) => {
   226	    engine.onServerLine(line);
   227	    const id = tabIdRef.current;
   228	    setTabs((ts) =>
   229	      ts.map((x) =>
   230	        x.id === id ? { ...x, log: [...x.log.slice(-5000), line] } : x,
   231	      ),
   232	    );
   233	  }, []);
   234	
   235	  const wsUrl = useMemo(() => {
   236	    if (!tab?.connected) return null;
   237	    if (trustMode === "local" && typeof window !== "undefined") {
   238	      const h = window.location.hostname;
   239	      if (h === "127.0.0.1" || h === "localhost") {
   240	        return "ws://127.0.0.1:7788/ws";
   241	      }
   242	    }
   243	    return resolveWsUrl(trustMode, {
   244	      envDefault: DEFAULT_WS,
   245	      customWs,
   246	      officialUrl: readOfficialProxyUrl(),
   247	    });
   248	  }, [tab?.connected, trustMode, customWs]);
   249	
   250	  const hello: HelloMsg = useMemo(
   251	    () => ({
   252	      type: "hello",
   253	      token: token || undefined,
   254	      host: profile.host,
   255	      port: profile.port,
   256	      cols: 80,
   257	      rows: 28,
   258	    }),
   259	    [token, profile],
   260	  );
   261	
   262	  const onSendThroughEngine = useCallback((line: string) => {
   263	    const expanded = engine.expandInput(line);
   264	    for (const l of expanded) {
   265	      const dir = l.trim().toLowerCase();
   266	      if (["n", "s", "e", "w", "ne", "nw", "se", "sw", "u", "d"].includes(dir)) {
   267	        clientMap.move(dir as "n", dir);
   268	        setMapAscii(clientMap.ascii(4));
   269	      }
   270	    }
   271	    return expanded;
   272	  }, []);
   273	
   274	  const downloadLog = () => {
   275	    const blob = new Blob([tab.log.join("\n")], { type: "text/plain" });
   276	    const a = document.createElement("a");
   277	    a.href = URL.createObjectURL(blob);
   278	    a.download = `assmud-session-${tab.id}.log`;
   279	    a.click();
   280	  };
   281	
   282	  const exportProfiles = () => {
   283	    const blob = new Blob([exportProfilesJson(profiles)], {
   284	      type: "application/json",
   285	    });
   286	    const a = document.createElement("a");
   287	    a.href = URL.createObjectURL(blob);
   288	    a.download = "assmud-profiles.json";
   289	    a.click();
   290	  };
   291	
   292	  const importProfilesFile = async (file: File) => {
   293	    const text = await file.text();
   294	    const list = importProfilesJson(text);
   295	    setProfiles(list);
   296	    saveProfiles(list);
   297	  };
   298	
   299	  const connectTab = () => {
   300	    setTabs((ts) =>
   301	      ts.map((x) => (x.id === tabId ? { ...x, connected: true } : x)),
   302	    );
   303	  };
   304	
   305	  const disconnectTab = () => {
