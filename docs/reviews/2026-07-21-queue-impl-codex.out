     1	import { useEffect, useMemo, useRef, useState } from "react";
     2	import { Canvas2DRenderer } from "@assmud/terminal";
     3	import {
     4	  STATIC_CATALOG,
     5	  applyPreset,
     6	  resolveFontStackProbed,
     7	  type TermFontConfig,
     8	} from "../termFonts/catalog";
     9	import { isAlignScoreGood, probeCjkGlyph, TRIAL_FIXTURE } from "../termFonts/trial";
    10	
    11	type Props = {
    12	  open: boolean;
    13	  base: TermFontConfig;
    14	  locale: "zh-TW" | "zh-CN" | "en";
    15	  onClose: () => void;
    16	  onApply: (cfg: TermFontConfig) => void;
    17	};
    18	
    19	export function FontTrialPanel({
    20	  open,
    21	  base,
    22	  locale,
    23	  onClose,
    24	  onApply,
    25	}: Props) {
    26	  const [leftId, setLeftId] = useState(base.presetId);
    27	  const [rightId, setRightId] = useState(
    28	    STATIC_CATALOG.find((c) => c.id !== base.presetId)?.id ?? "jetbrains-mono",
    29	  );
    30	  const [customPrimary, setCustomPrimary] = useState(base.primary);
    31	  const leftCanvas = useRef<HTMLCanvasElement>(null);
    32	  const rightCanvas = useRef<HTMLCanvasElement>(null);
    33	  const [scores, setScores] = useState({ left: 0, right: 0 });
    34	
    35	  const leftCfg = useMemo(() => {
    36	    const p = applyPreset(leftId);
    37	    return leftId === "custom" ? { ...p, primary: customPrimary, presetId: "custom" } : p;
    38	  }, [leftId, customPrimary]);
    39	  const rightCfg = useMemo(() => applyPreset(rightId), [rightId]);
    40	
    41	  useEffect(() => {
    42	    if (!open) return;
    43	    const run = (canvas: HTMLCanvasElement | null, cfg: TermFontConfig) => {
    44	      if (!canvas) return 0;
    45	      const r = new Canvas2DRenderer();
    46	      r.mount(canvas);
    47	      const stack = resolveFontStackProbed(cfg, locale);
    48	      r.setTypography({
    49	        fontFamily: stack,
    50	        fontSizePx: cfg.fontSizePx,
    51	        cellWidthScale: cfg.cellWidthScale,
    52	        lineHeightScale: cfg.lineHeightScale,
    53	      });
    54	      const score = r.measureAlignScore();
    55	      const probe = probeCjkGlyph(
    56	        cfg.primary.includes(" ") ? `"${cfg.primary}"` : cfg.primary,
    57	      );
    58	      // draw fixture sample line
    59	      const ctx = canvas.getContext("2d");
    60	      if (ctx) {
    61	        ctx.fillStyle = "#0a0b0e";
    62	        ctx.fillRect(0, 0, canvas.width, canvas.height);
    63	        ctx.fillStyle = "#e8eaed";
    64	        ctx.font = `500 ${cfg.fontSizePx}px ${stack}`;
    65	        ctx.textBaseline = "top";
    66	        TRIAL_FIXTURE.split("\n").forEach((line, i) => {
    67	          ctx.fillText(line, 4, 4 + i * (cfg.fontSizePx + 4));
    68	        });
    69	        if (!probe.ok) {
    70	          ctx.fillStyle = "#f59e0b";
    71	          ctx.font = `500 10px monospace`;
    72	          ctx.fillText("CJK glyph probe: miss → TC chain", 4, 78);
    73	        }
    74	      }
    75	      r.dispose();
    76	      return score;
    77	    };
    78	    // next frame so canvas is laid out
    79	    const id = requestAnimationFrame(() => {
    80	      setScores({
    81	        left: run(leftCanvas.current, leftCfg),
    82	        right: run(rightCanvas.current, rightCfg),
    83	      });
    84	    });
    85	    return () => cancelAnimationFrame(id);
    86	  }, [open, leftCfg, rightCfg, locale]);
    87	
    88	  if (!open) return null;
    89	
    90	  return (
    91	    <div
    92	      className="fixed inset-0 z-50 flex items-center justify-center p-4"
    93	      style={{ background: "rgba(0,0,0,0.65)" }}
    94	      role="dialog"
    95	      aria-label="Font trial"
    96	    >
    97	      <div
    98	        className="w-full max-w-3xl rounded-[var(--radius)] border p-4 max-h-[90vh] overflow-auto"
    99	        style={{ background: "var(--bg-panel)", borderColor: "var(--border)" }}
   100	      >
   101	        <div className="flex justify-between items-center mb-3">
   102	          <h2 className="text-sm font-semibold" style={{ color: "var(--text)" }}>
   103	            Font trial A/B
   104	          </h2>
   105	          <button type="button" className="text-xs" onClick={onClose}>
   106	            ✕
   107	          </button>
   108	        </div>
   109	        <div className="grid sm:grid-cols-2 gap-3">
   110	          {(
   111	            [
   112	              ["A", leftId, setLeftId, leftCanvas, scores.left, leftCfg],
   113	              ["B", rightId, setRightId, rightCanvas, scores.right, rightCfg],
   114	            ] as const
   115	          ).map(([label, id, setId, cref, score, cfg]) => (
   116	            <div key={label} className="space-y-2">
   117	              <div className="flex items-center gap-2">
   118	                <span className="text-xs font-mono" style={{ color: "var(--accent)" }}>
   119	                  {label}
   120	                </span>
   121	                <select
   122	                  className="flex-1 text-xs rounded border px-2 py-1"
   123	                  style={{
   124	                    background: "var(--bg-elevated)",
   125	                    borderColor: "var(--border)",
   126	                    color: "var(--text)",
   127	                  }}
   128	                  value={id}
   129	                  onChange={(e) => setId(e.target.value)}
   130	                >
   131	                  {STATIC_CATALOG.map((c) => (
   132	                    <option key={c.id} value={c.id}>
   133	                      {c.label}
   134	                    </option>
   135	                  ))}
   136	                </select>
   137	              </div>
   138	              {label === "A" && id === "custom" && (
   139	                <input
   140	                  className="w-full text-xs font-mono rounded border px-2 py-1"
   141	                  style={{
   142	                    background: "var(--bg-elevated)",
   143	                    borderColor: "var(--border)",
   144	                    color: "var(--text)",
   145	                  }}
   146	                  value={customPrimary}
   147	                  onChange={(e) => setCustomPrimary(e.target.value)}
   148	                  placeholder="Custom primary family"
   149	                />
   150	              )}
   151	              <canvas
   152	                ref={cref}
   153	                width={320}
   154	                height={96}
   155	                className="w-full rounded border"
   156	                style={{ borderColor: "var(--border)", background: "#0a0b0e" }}
   157	              />
   158	              <p className="text-[11px] font-mono" style={{ color: "var(--text-dim)" }}>
   159	                alignScore={score.toFixed(3)}{" "}
   160	                {isAlignScoreGood(score) ? (
   161	                  <span style={{ color: "var(--accent)" }}>≈2.0 ✓</span>
   162	                ) : (
   163	                  <span style={{ color: "var(--text-faint)" }}>off dual-width</span>
   164	                )}
   165	              </p>
   166	              <button
   167	                type="button"
   168	                className="text-xs rounded px-2 py-1 font-semibold"
   169	                style={{ background: "var(--accent)", color: "#0a0b0e" }}
   170	                onClick={() => onApply(cfg)}
   171	              >
   172	                Use {label}
   173	              </button>
   174	            </div>
   175	          ))}
   176	        </div>
   177	      </div>
   178	    </div>
   179	  );
   180	}
     1	import { describe, it, expect } from "vitest";
     2	import { isAlignScoreGood, probeCjkGlyph, TRIAL_FIXTURE } from "../src/termFonts/trial";
     3	import {
     4	  resolveFontStack,
     5	  resolveFontStackProbed,
