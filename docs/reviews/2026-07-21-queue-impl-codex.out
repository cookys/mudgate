    42	  });
    43	
    44	  it("resolveFontStackProbed matches resolveFontStack in node", () => {
    45	    const a = resolveFontStack(DEFAULT_TERM_FONT, "zh-TW");
    46	    const b = resolveFontStackProbed(DEFAULT_TERM_FONT, "zh-TW");
    47	    expect(b).toBe(a);
    48	  });
    49	});
     1	import { describe, it, expect } from "vitest";
     2	import { AbuseLimiter, defaultLimits, normalizeIp } from "../src/limits.js";
     3	
     4	describe("AbuseLimiter", () => {
     5	  it("normalizes IPv4-mapped IPv6", () => {
     6	    expect(normalizeIp("::ffff:1.2.3.4")).toBe("1.2.3.4");
     7	  });
     8	
     9	  it("enforces concurrent WS per IP", () => {
    10	    const lim = new AbuseLimiter({
    11	      ...defaultLimits("remote-prod"),
    12	      concurrentWsPerIp: 2,
    13	      concurrentWsPerToken: 10,
    14	    });
    15	    const a = lim.tryAcquire("1.1.1.1", "t");
    16	    const b = lim.tryAcquire("1.1.1.1", "t2");
    17	    const c = lim.tryAcquire("1.1.1.1", "t3");
    18	    expect(a).not.toBeNull();
    19	    expect(b).not.toBeNull();
    20	    expect(c).toBeNull();
    21	    a!();
    22	    const d = lim.tryAcquire("1.1.1.1", "t3");
    23	    expect(d).not.toBeNull();
    24	    d!();
    25	    b!();
    26	  });
    27	
    28	  it("enforces concurrent WS per token", () => {
    29	    const lim = new AbuseLimiter({
    30	      ...defaultLimits("remote-prod"),
    31	      concurrentWsPerIp: 100,
    32	      concurrentWsPerToken: 1,
    33	    });
    34	    const a = lim.tryAcquire("1.1.1.1", "tok");
    35	    const b = lim.tryAcquire("2.2.2.2", "tok");
    36	    expect(a).not.toBeNull();
    37	    expect(b).toBeNull();
    38	    a!();
    39	  });
    40	
    41	  it("rate-limits upgrades per IP per minute", () => {
    42	    const lim = new AbuseLimiter({
    43	      ...defaultLimits("remote-prod"),
    44	      upgradesPerIpPerMin: 3,
    45	    });
    46	    expect(lim.tryUpgrade("9.9.9.9")).toBe(true);
    47	    expect(lim.tryUpgrade("9.9.9.9")).toBe(true);
    48	    expect(lim.tryUpgrade("9.9.9.9")).toBe(true);
    49	    expect(lim.tryUpgrade("9.9.9.9")).toBe(false);
    50	  });
    51	
    52	  it("hosted defaults tighter than dev", () => {
    53	    expect(defaultLimits("remote-prod").concurrentWsPerIp).toBeLessThan(
    54	      defaultLimits("localhost-dev").concurrentWsPerIp,
    55	    );
    56	  });
    57	});
     1	# Hosted proxy threat model
     2	
     3	> Product path: **browser (desktop or phone) → authenticated WSS → official/self-hosted proxy → TCP MUD**.  
     4	> Localhost proxy is **dev / advanced desktop** only — not how phone users connect.
     5	
     6	## Assets
     7	
     8	| Asset | Why it matters |
     9	|-------|----------------|
    10	| User account identity | Attribution, ban, abuse response |
    11	| Session tokens | Hijack = play as user |
    12	| Egress TCP from proxy IP | Open-relay / scanning / legal exposure |
    13	| Game passwords on mud hop | Often cleartext telnet — must not log |
    14	| Audit metadata | Who connected where/when |
    15	
    16	## Threats → controls
    17	
    18	| Threat | Control (required for official host) |
    19	|--------|--------------------------------------|
    20	| Anonymous open-relay | **Auth required** before any upstream TCP |
    21	| Port scan / attack third parties | **Destination allowlist** (v1) or request+approve; rate limits; fail-closed |
    22	| SSRF (localhost, metadata, RFC1918) | Block private/link-local/metadata IPs; re-check after DNS on **every** new upstream connect |
    23	| Credential logging | **Never** log telnet payloads by default; metadata-only audit |
    24	| Session theft | Short-lived tokens; **httpOnly + Secure + SameSite=Strict** session cookie (or equivalent); revoke on logout |
    25	| Cross-site WebSocket hijack | Validate **`Origin`** (and Host) on WSS upgrade against allowlist; reject missing/mismatched Origin in prod |
    26	| Resource exhaustion | Per-IP/token concurrency + upgrade/hello rate limits (`apps/proxy/src/limits.ts`); MCCP inflate caps; deploy runbook |
    27	| DNS rebinding | Resolve → validate IP → connect; deny if rebinding class; re-validate per connect |
    28	| Insider / support tools | No default full-stream capture; explicit time-boxed consent only |
    29	| Malicious trigger package | Declarative engine **cannot** read document cookies, `localStorage` secrets, or arbitrary `fetch` to exfiltrate session |
    30	
    31	## Modes
    32	
    33	| Mode | Audience | Auth | Destinations | Bind |
    34	|------|----------|------|--------------|------|
    35	| **Official / self-host prod** | Desktop + phone browsers | Required | Allowlist (or approved custom) | Public WSS |
    36	| **Dev localhost** | Developers | Optional (token/dev header OK) | May skip public allowlist **only** for non-private destinations; **always** block private/metadata IPs | `127.0.0.1` |
    37	| **User-run remote** | Power users | Their choice | Their policy | Their VPS |
    38	
    39	### Auth / session (pinned for Phase 1a)
    40	
    41	| Decision | Choice (v1) |
    42	|----------|-------------|
    43	| Browser session | **HTTP-only Secure cookie** after login (magic-link or OAuth TBD in impl) |
    44	| WSS auth | Cookie sent on same-site upgrade **or** short-lived ticket in first WS control frame (pick one in impl; document in proxy README) |
    45	| Duration | Access session ≥30 min with sliding idle refresh; hard logout revoke |
    46	| CSRF / WS | Origin allowlist + SameSite=Strict; no third-party embedding of authenticated WSS without explicit allow |
    47	
    48	## Minimum ship checklist (official)
    49	
    50	1. Unauthenticated WSS cannot open TCP.
    51	2. Automated denies: `127.0.0.1`, `10/8`, `169.254.169.254`, non-allowlisted host.
    52	3. Concurrent session limits enforced.
    53	4. Audit log has user_id + dest + timestamps + byte counts — **no password strings** in samples.
    54	5. TLS (WSS) only on public endpoints.
    55	6. ToS + kill-switch (ban user_id / revoke sessions).
    56	
    57	## Self-host / malicious proxy
    58	
    59	| Threat | Control |
    60	|--------|---------|
    61	| Stranger-operated `wss://` steals MUD passwords | Product trust UI (T3 hell warning); no public node directory |
    62	| Self-host publish 7788 open | Default bind **127.0.0.1**; TLS/tunnel only on 443 |
    63	| Token in URL/logs | remote-prod: Bearer/cookie only; install writes **0600** file |
    64	| Empty Origin allowlist | remote-prod **fail-closed** |
    65	| Cloudflare Tunnel misuse | Ingress only; Access no world Bypass; egress remains home/VPS IP |
    66	
    67	**WSS ≠ E2E password privacy.** Cleartext telnet to MUD is always visible to the process that holds the upstream TCP socket.
    68	
    69	## Explicit non-goals
    70	
    71	- Guaranteeing E2E encryption when the target MUD is cleartext telnet.
    72	- Expecting phone users to run a local proxy app.
    73	- Browser/WASM raw TCP.
    74	- Claiming phone UX equals desktop for dense map_d / power-user scripting (we improve mobile; we stay honest).
     1	# HTTPS + WSS deploy recipe
     2	
     3	Aligns with `apps/proxy` `policy.ts` / remote-prod.
     4	
     5	## Required env (remote-prod)
     6	
     7	| Env | Rule |
     8	|-----|------|
     9	| `ASSMUD_PROXY_MODE=remote-prod` | fail-closed |
    10	| `ASSMUD_AUTH_TOKEN` | required; Bearer/cookie only (no query in prod) |
    11	| `ASSMUD_ORIGIN_ALLOWLIST` | comma HTTPS origins; **empty refuses start** |
    12	| `ASSMUD_BIND_HOST` | default **127.0.0.1** — TLS terminator fronts 443 |
    13	| `ASSMUD_MCCP=1` | optional; inflate caps via `ASSMUD_MCCP_MAX_*` |
    14	
    15	## Topology
    16	
    17	```
    18	Browser ──WSS──► Caddy/nginx (TLS) ──► 127.0.0.1:7788 proxy ──TCP──► MUD
    19	```
    20	
    21	See `deploy/Caddyfile.proxy.example`, `deploy/docker-compose.proxy.yml`.
    22	
    23	## MCCP caps (proxy)
    24	
    25	| Env | Default role |
    26	|-----|----------------|
    27	| `ASSMUD_MCCP_MAX_WINDOW_BYTES` | per-window inflate |
    28	| `ASSMUD_MCCP_MAX_SESSION_BYTES` | session inflate |
    29	| `ASSMUD_MCCP_MAX_WIRE_BYTES` | compressed wire |
    30	
    31	Never log telnet payloads / passwords.

