     1	#!/usr/bin/env bash
     2	# assmud self-host proxy installer (interactive).
     3	# Pin chain: verify this script SHA-256 from release notes, then it pulls a digest-pinned image.
     4	set -euo pipefail
     5	
     6	INSTALLER_VERSION="${ASSMUD_INSTALLER_VERSION:-0.1.0-dev}"
     7	# Override for real releases: ASSMUD_PROXY_IMAGE=ghcr.io/OWNER/assmud-proxy@sha256:...
     8	IMAGE="${ASSMUD_PROXY_IMAGE:-}"
     9	ORIGIN="${ASSMUD_ORIGIN_ALLOWLIST:-}"
    10	TOKEN_FILE="${ASSMUD_TOKEN_FILE:-/etc/assmud/auth_token}"
    11	COMPOSE_DIR="${ASSMUD_COMPOSE_DIR:-/opt/assmud}"
    12	
    13	echo "assmud-proxy installer ${INSTALLER_VERSION}"
    14	
    15	if [[ "$(id -u)" -ne 0 ]]; then
    16	  echo "Run as root (sudo)." >&2
    17	  exit 1
    18	fi
    19	
    20	if [[ -z "$IMAGE" ]]; then
    21	  echo "Set ASSMUD_PROXY_IMAGE to a digest-pinned image, e.g.:" >&2
    22	  echo "  export ASSMUD_PROXY_IMAGE=ghcr.io/OWNER/assmud-proxy@sha256:…" >&2
    23	  exit 1
    24	fi
    25	
    26	if [[ "$IMAGE" == *":latest" ]]; then
    27	  echo "Refusing :latest — use @sha256: digest pin." >&2
    28	  exit 1
    29	fi
    30	
    31	if [[ -z "$ORIGIN" ]]; then
    32	  echo "Set ASSMUD_ORIGIN_ALLOWLIST (comma-separated https origins). Empty is fail-closed." >&2
    33	  exit 1
    34	fi
    35	
    36	if ! command -v docker >/dev/null 2>&1; then
    37	  echo "docker required" >&2
    38	  exit 1
    39	fi
    40	
    41	mkdir -p "$(dirname "$TOKEN_FILE")" "$COMPOSE_DIR"
    42	# MUST: do not leave token in shell history
    43	set +o history 2>/dev/null || true
    44	TOKEN="$(openssl rand -hex 24)"
    45	umask 077
    46	printf '%s' "$TOKEN" >"$TOKEN_FILE"
    47	chmod 600 "$TOKEN_FILE"
    48	chown root:root "$TOKEN_FILE" 2>/dev/null || true
    49	
    50	cat >"$COMPOSE_DIR/.env" <<EOF
    51	ASSMUD_PROXY_IMAGE=${IMAGE}
    52	ASSMUD_AUTH_TOKEN=${TOKEN}
    53	ASSMUD_ORIGIN_ALLOWLIST=${ORIGIN}
    54	EOF
    55	chmod 600 "$COMPOSE_DIR/.env"
    56	
    57	# Minimal compose (loopback via host network)
    58	cat >"$COMPOSE_DIR/docker-compose.yml" <<EOF
    59	services:
    60	  proxy:
    61	    image: \${ASSMUD_PROXY_IMAGE}
    62	    restart: unless-stopped
    63	    env_file: .env
    64	    environment:
    65	      ASSMUD_PROXY_MODE: remote-prod
    66	      ASSMUD_BIND_HOST: "127.0.0.1"
    67	      PORT: "7788"
    68	    network_mode: host
    69	EOF
    70	
    71	docker pull "$IMAGE"
    72	(cd "$COMPOSE_DIR" && docker compose up -d)
    73	
    74	echo ""
    75	echo "=== INSTALL COMPLETE ==="
    76	echo "Token (shown once — treat as password; do not paste in chat):"
    77	echo "$TOKEN"
    78	echo "Also stored 0600 at: $TOKEN_FILE"
    79	echo "Retrieve later: sudo cat $TOKEN_FILE"
    80	echo "Front with Caddy or cloudflared → 127.0.0.1:7788 (do not publish 7788)."
    81	echo "Origin allowlist only limits browser Origin; it does not replace the token."
    82	echo "Proxy operators can read cleartext MUD passwords — only run on machines you control."
     1	# assmud proxy — self-host defaults (loopback only).
     2	# Front with Caddy/cloudflared on 443. Do not publish 7788 to the internet.
     3	#
     4	# Required env: ASSMUD_AUTH_TOKEN, ASSMUD_ORIGIN_ALLOWLIST
     5	services:
     6	  proxy:
     7	    image: ${ASSMUD_PROXY_IMAGE:-ghcr.io/example/assmud-proxy:pin-me}
     8	    # Prefer: ASSMUD_PROXY_IMAGE=ghcr.io/OWNER/assmud-proxy@sha256:...
     9	    restart: unless-stopped
    10	    environment:
    11	      ASSMUD_PROXY_MODE: remote-prod
    12	      ASSMUD_AUTH_TOKEN: ${ASSMUD_AUTH_TOKEN:?set token}
    13	      ASSMUD_ORIGIN_ALLOWLIST: ${ASSMUD_ORIGIN_ALLOWLIST:?set origins}
    14	      ASSMUD_BIND_HOST: "127.0.0.1"
    15	      PORT: "7788"
    16	    network_mode: host
    17	    # With network_mode host, bind 127.0.0.1:7788 on the host only.

