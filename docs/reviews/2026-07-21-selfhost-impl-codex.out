    "es-module-lexer": "^1.5.4",
    "pathe": "^1.1.2",
    "vite": "^5.0.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.25",
    "@types/debug": "^4.1.12",
    "tinyrainbow": "^1.2.0"
  },
  "scripts": {
