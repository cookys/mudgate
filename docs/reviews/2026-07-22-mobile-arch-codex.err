}

/* Visual-viewport driven shell (mobile keyboard). Fallback: 100dvh. */
html,
body,
#root {
  height: var(--app-vh, 100dvh);
  max-height: var(--app-vh, 100dvh);
  overflow: hidden;
}

body {
  margin: 0;
  background: var(--bg-void);
  color: var(--text);
  font-family: var(--font-ui);
  -webkit-font-smoothing: antialiased;
  /* Prevent iOS rubber-band from scrolling chrome off-screen */
  overscroll-behavior: none;
  touch-action: manipulation;
}

/* Keyboard open: compact chrome (class set by useVisualViewport) */
html.kb-open {
  --topbar-h: 36px;
  --cmd-h: 48px;
}

/* Only hide chrome when *actually* typing (see useVisualViewport). */
