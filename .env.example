# Copy to `.env` for local development. Never commit `.env`.
# All values below are non-secret placeholders.

# Public web origin (production must be https://)
# PUBLIC_ORIGIN=https://mud.example.com

# WebSocket bridge (production must be wss://)
# BRIDGE_URL=wss://mud.example.com/ws

# Local TCP bridge bind (dev)
# BRIDGE_HOST=127.0.0.1
# BRIDGE_PORT=7788

# Default MUD target for smoke (no credentials)
# DEFAULT_MUD_HOST=mud.revivalworld.org
# DEFAULT_MUD_PORT=4000
# DEFAULT_MUD_CHARSET=big5

# Relay mode: deny open connections to arbitrary hosts unless allowlisted
# RELAY_ALLOWLIST=mud.revivalworld.org,localhost
# RELAY_REQUIRE_AUTH=true
