# Copy to `.env` (gitignored). Never commit secrets.
# Proxy loads this automatically from repo root (apps/proxy loadDotEnv).
#
# Local LAN dev (default if unset):
#   ASSMUD_PROXY_MODE=localhost-dev
#
# RW site mode on mud host (same machine as driver):
#   cp .env.example .env  &&  edit token/origin  &&  npm run start -w @assmud/proxy

# --- mode ---
ASSMUD_PROXY_MODE=localhost-dev
# ASSMUD_PROXY_MODE=remote-prod
# ASSMUD_SITE_MODE=1

# --- remote-prod / site (required when mode=remote-prod) ---
# ASSMUD_AUTH_TOKEN=generate-with-openssl-rand-hex-24
# ASSMUD_ORIGIN_ALLOWLIST=https://play.revivalworld.org,http://127.0.0.1:5173

# Site mode: ONLY these muds (empty + SITE_MODE=1 → startup fail)
# Same-box RW driver:
# ASSMUD_ALLOWLIST=127.0.0.1:4000,127.0.0.1:4001,127.0.0.1:5000,127.0.0.1:6000

# Bind (site: keep loopback; put TLS terminator in front)
ASSMUD_BIND_HOST=127.0.0.1
PORT=7788

# Trust reverse-proxy hop for client IP headers (optional)
# ASSMUD_TRUSTED_HOP=127.0.0.1/32
# ASSMUD_CLIENT_IP_HEADER=x-real-ip

# Audit log file (optional; default stderr JSON lines)
# ASSMUD_AUDIT_LOG=/home/user/admin/cookys/var/log/assmud-proxy-audit.jsonl

# MCCP (default on)
# ASSMUD_MCCP=1

# --- Web build-time (Vite) — set before: npm run build -w @assmud/web ---
# VITE_PROXY_WS=ws://127.0.0.1:7788/ws
# VITE_PROXY_WS=wss://play.revivalworld.org/ws
# VITE_DEFAULT_LOCALE=zh-TW
